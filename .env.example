# Turso Cloud: libsql://<db>-<org>.turso.io  (get it with: turso db show <db> --url)
# Offline local dev instead: TURSO_DATABASE_URL=file:local.db  (no token needed)
TURSO_DATABASE_URL=libsql://chopquest-yourorg.turso.io
TURSO_AUTH_TOKEN=
# AI via OpenRouter (team credits): Claude Haiku 5.5 ($0.10/$0.50 per 1M tokens), falling back to Claude Sonnet 4.6.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_MODEL_FALLBACK=anthropic/claude-sonnet-4.6   # "none" turns the fallback off
