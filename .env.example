# Turso Cloud: libsql://<db>-<org>.turso.io  (get it with: turso db show <db> --url)
# Offline local dev instead: TURSO_DATABASE_URL=file:local.db  (no token needed)
TURSO_DATABASE_URL=libsql://chopquest-yourorg.turso.io
TURSO_AUTH_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# AI via OpenRouter (team credits). Replaces GEMINI_API_KEY once Pascal's client lands.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL_FALLBACK=
